{
	"name": "obsidian-git-facil",
	"version": "1.3.1",
	"description": "Plugin de Git sencillo para Obsidian",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.js",
		"build": "node esbuild.config.js production",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"test": "vitest run",
		"deploy": "node scripts/deploy.mjs"
	},
	"keywords": ["obsidian", "obsidian-plugin", "git"],
	"author": "Alexwce",
	"license": "MIT",
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"tslib": "^2.6.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^24.0.0",
		"esbuild": "^0.20.0",
		"obsidian": "^1.13.1",
		"typescript": "^5.3.3",
		"vitest": "^1.2.0"
	}
}
