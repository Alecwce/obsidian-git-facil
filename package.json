{
	"name": "obsidian-git-facil",
	"version": "1.4.3",
	"description": "Plugin de Git sencillo para Obsidian",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.js",
		"build": "node esbuild.config.js production",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"test": "vitest run",
		"deploy": "node scripts/deploy.mjs",
		"validate:submission": "node scripts/submission-check.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"git"
	],
	"author": "Alexwce",
	"license": "MIT",
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"tslib": "^2.6.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/node": "^26.4.1",
		"esbuild": "^0.28.2",
		"obsidian": "^1.13.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}
}
